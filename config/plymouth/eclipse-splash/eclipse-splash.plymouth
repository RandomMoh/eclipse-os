[Plymouth Theme]
Name=Eclipse OS Boot Splash
Description=High-resolution graphical boot splash logo for Eclipse OS
ModuleName=two-step

[two-step]
ImageDir=/usr/share/plymouth/themes/eclipse-splash
HorizontalAlignment=.5
VerticalAlignment=.5
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.5
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0x0a0809
BackgroundEndColor=0x0a0809

[boot-up]
UseEndAnimation=false

[shutdown]
UseEndAnimation=false

[reboot]
UseEndAnimation=false
