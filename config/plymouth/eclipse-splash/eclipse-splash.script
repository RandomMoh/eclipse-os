# Eclipse OS Plymouth Boot Splash Script

Window.SetBackgroundTopColor(0.04, 0.03, 0.04);
Window.SetBackgroundBottomColor(0.04, 0.03, 0.04);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);

fun refresh_callback () {
    screen_width = Window.GetWidth();
    screen_height = Window.GetHeight();
    
    if (screen_width > 0 && screen_height > 0) {
        logo_x = (screen_width - logo.image.GetWidth()) / 2;
        logo_y = (screen_height - logo.image.GetHeight()) / 2;
        
        logo.sprite.SetX(logo_x);
        logo.sprite.SetY(logo_y);
        logo.sprite.SetOpacity(1.0);
    }
}

Plymouth.SetRefreshFunction(refresh_callback);
refresh_callback();
