def cmd_theme(args):
    theme_choice = args.name.lower()
    if theme_choice not in THEME_CONFIGS:
        console.print(f"[bold red]Error:[/bold red] Unknown theme '{theme_choice}'. Options: fedora, adwaita, cyan, emerald")
        sys.exit(1)

    cfg = THEME_CONFIGS[theme_choice]
    accent = cfg["accent"]
    highlight = cfg["highlight"]
    theme_folder = cfg["folder"]

    # 1. Copy theme folder / files to ~/.config/gtk-3.0/
    user_config_dir = os.path.expanduser("~/.config/gtk-3.0")
    os.makedirs(user_config_dir, exist_ok=True)

    source_candidates = [
        f"/usr/share/themes/{theme_folder}/gtk-3.0",
        os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "config", "gtk", "themes", theme_folder, "gtk-3.0"),
        f"/home/mohs/eclipse-os/config/gtk/themes/{theme_folder}/gtk-3.0",
    ]

    copied_from = None
    for candidate in source_candidates:
        candidate_path = os.path.abspath(candidate)
        if os.path.exists(candidate_path):
            try:
                for item in os.listdir(candidate_path):
                    s_file = os.path.join(candidate_path, item)
                    d_file = os.path.join(user_config_dir, item)
                    if os.path.isfile(s_file):
                        shutil.copy2(s_file, d_file)
                    elif os.path.isdir(s_file):
                        if os.path.exists(d_file):
                            shutil.rmtree(d_file)
                        shutil.copytree(s_file, d_file)
                copied_from = candidate_path
                break
            except Exception:
                pass

    user_css_path = os.path.join(user_config_dir, "gtk.css")
    if not os.path.exists(user_css_path):
        css_content = (
            f"/* Eclipse OS Custom GTK Accent: {cfg['name']} */\n"
            f"@define-color accent_color {accent};\n"
            f"@define-color highlight_color {highlight};\n"
            f"@define-color theme_bg_color #0B0D14;\n"
            f"@define-color theme_fg_color #E2E8F0;\n"
            f"@define-color theme_selected_bg_color {accent};\n"
            f"@define-color theme_selected_fg_color #FFFFFF;\n"
        )
        try:
            with open(user_css_path, "w") as f:
                f.write(css_content)
        except Exception:
            pass

    # 2. Update ~/.config/kdeglobals for KDE Plasma AccentColor
    kdeglobals_path = os.path.expanduser("~/.config/kdeglobals")
    if os.path.exists(kdeglobals_path):
        try:
            rgb_map = {
                "#3584E4": "53,132,228",
                "#24292E": "53,132,228",
                "#06B6D4": "6,182,212",
                "#10B981": "16,185,129",
                "#E11D48": "225,29,72",
            }
            rgb_val = rgb_map.get(accent, "53,132,228")
            with open(kdeglobals_path, "r") as f:
                lines = f.readlines()
            new_lines = []
            for line in lines:
                if line.startswith("AccentColor="):
                    new_lines.append(f"AccentColor={rgb_val}\n")
                else:
                    new_lines.append(line)
            with open(kdeglobals_path, "w") as f:
                f.writelines(new_lines)
        except Exception:
            pass

    # 3. Update ~/.config/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml
    xsettings_dir = os.path.expanduser("~/.config/xfce4/xfconf/xfce-perchannel-xml")
    os.makedirs(xsettings_dir, exist_ok=True)
    xsettings_path = os.path.join(xsettings_dir, "xsettings.xml")

    xml_updated = False
    if os.path.exists(xsettings_path):
        try:
            with open(xsettings_path, "r") as f:
                content = f.read()
            import re
            new_content = re.sub(
                r'(<property\s+name="ThemeName"\s+type="string"\s+value=")[^"]*("/>)',
                rf'\g<1>{theme_folder}\2',
                content
            )
            with open(xsettings_path, "w") as f:
                f.write(new_content)
            xml_updated = True
        except Exception:
            pass

    if not xml_updated:
        default_xml = (
            '<?xml version="1.0" encoding="UTF-8"?>\n\n'
            '<channel name="xsettings" version="1.0">\n'
            '  <property name="Net" type="empty">\n'
            f'    <property name="ThemeName" type="string" value="{theme_folder}"/>\n'
            '    <property name="IconThemeName" type="string" value="Papirus-Dark"/>\n'
            '  </property>\n'
            '</channel>\n'
        )
        try:
            with open(xsettings_path, "w") as f:
                f.write(default_xml)
        except Exception:
            pass

    # Dynamically update running XFCE session if xfconf-query is present
    if shutil.which("xfconf-query"):
        subprocess.run(["xfconf-query", "-c", "xsettings", "-p", "/Net/ThemeName", "-s", theme_folder], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)

    console.print(Panel(
        f"[bold green]Theme updated successfully to {theme_folder}![/bold green]\n\n"
        f"[white]Active Accent:[/white] [{accent}]{cfg['name']} ({accent})[/{accent}]\n"
        f"[white]GTK Config Directory:[/white] [dim]{user_config_dir}[/dim]\n"
        f"[white]XSettings Configuration:[/white] [dim]{xsettings_path}[/dim]",
        title="[bold #62A0EA]Eclipse OS Desktop Theme Controller[/bold #62A0EA]",
        border_style=accent
    ))

def run_step_cmd(cmd, is_root=False):
    full_cmd = cmd if is_root else (["sudo"] + cmd if shutil.which("sudo") else cmd)
    try:
        subprocess.run(full_cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
        return True
    except Exception:
        return False

def update_laravel_installer(is_root=False):
    try:
        env = os.environ.copy()
        env["COMPOSER_ALLOW_SUPERUSER"] = "1"
        subprocess.run(["composer", "global", "require", "laravel/installer"], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
        composer_bin = os.path.expanduser("~/.config/composer/vendor/bin/laravel")
        root_composer_bin = "/root/.config/composer/vendor/bin/laravel"
        target_bin = "/usr/local/bin/laravel"
        src_bin = composer_bin if os.path.exists(composer_bin) else root_composer_bin
        if os.path.exists(src_bin) and not os.path.exists(target_bin):
            run_step_cmd(["ln", "-sf", src_bin, target_bin], is_root)
        return True
    except Exception:
        return False

def update_flutter_sdk(is_root=False):
    flutter_bin = "/opt/flutter/bin/flutter"
    if os.path.exists(flutter_bin):
        subprocess.run([flutter_bin, "upgrade"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
        return True
    else:
        try:
            url = "https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_3.24.0-stable.tar.xz"
            tmp_tar = "/tmp/flutter_linux.tar.xz"
            subprocess.run(["curl", "-fsSL", "-o", tmp_tar, url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
            if os.path.exists(tmp_tar):
                os.makedirs("/opt", exist_ok=True)
                run_step_cmd(["tar", "-xf", tmp_tar, "-C", "/opt/"], is_root)
                os.remove(tmp_tar)
                profile_path = "/etc/profile.d/flutter.sh"
                if not os.path.exists(profile_path):
                    content = 'export PATH="$PATH:/opt/flutter/bin"\nexport FLUTTER_ROOT="/opt/flutter"\n'
                    if is_root:
                        with open(profile_path, "w") as f:
                            f.write(content)
                        os.chmod(profile_path, 0o755)
                return True
        except Exception:
            pass
        return False

def update_zen_browser(is_root=False):
    zen_bin = "/usr/local/bin/zen-browser"
    opt_zen = "/opt/zen/zen"
    if os.path.exists(zen_bin) and os.path.exists(opt_zen):
        return True
    try:
        url = "https://github.com/zen-browser/desktop/releases/latest/download/zen.linux-x86_64.tar.xz"
        tmp_tar = "/tmp/zen.linux-x86_64.tar.xz"
        res = subprocess.run(["curl", "-fsSL", "-o", tmp_tar, url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
        if res.returncode != 0:
            url = "https://github.com/zen-browser/desktop/releases/download/1.0.1-a.3/zen.linux-x86_64.tar.xz"
            subprocess.run(["curl", "-fsSL", "-o", tmp_tar, url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
        if os.path.exists(tmp_tar):
            os.makedirs("/opt/zen", exist_ok=True)
            run_step_cmd(["tar", "-xf", tmp_tar, "-C", "/opt/"], is_root)
            os.remove(tmp_tar)
            run_step_cmd(["ln", "-sf", "/opt/zen/zen", zen_bin], is_root)
            if os.path.exists("/opt/zen/zen"):
                run_step_cmd(["chmod", "+x", "/opt/zen/zen"], is_root)
            return True
    except Exception:
        pass
    return False

def cmd_install_devtools(args):
    console.print(Panel(
        "[bold #62A0EA]Eclipse OS Developer Toolchain Manager[/bold #62A0EA]\n"
        "[dim white]Automated setup, updates, and verification for LAMP stack, Node.js, Laravel, Flutter, Flame, & Zen Browser[/dim white]",
        border_style="#1C71D8"
    ))

    is_root = (os.geteuid() == 0)
    if not is_root:
        console.print("[bold yellow]Warning:[/bold yellow] Non-root execution detected. Privileged steps will use sudo or report permission constraints.\n")

    steps = [
        ("Updating APT package repositories", lambda: run_step_cmd(["apt-get", "update", "-y"], is_root)),
        ("Installing & updating Node.js & npm environment", lambda: run_step_cmd(["apt-get", "install", "-y", "nodejs", "npm"], is_root)),
        ("Installing & updating PHP and LAMP stack packages", lambda: run_step_cmd([
            "apt-get", "install", "-y", "apache2", "mariadb-server", "php", "php-cli",
            "php-mbstring", "php-xml", "php-curl", "php-mysql", "php-zip", "composer"
        ], is_root)),
        ("Updating Composer packages (laravel/installer)", lambda: update_laravel_installer(is_root)),
        ("Updating Flutter SDK (flutter upgrade)", lambda: update_flutter_sdk(is_root)),
        ("Updating & verifying Zen Browser binaries", lambda: update_zen_browser(is_root)),
    ]

    with Progress(
        SpinnerColumn(style="#62A0EA"),
        TextColumn("[bold white]{task.description}[/bold white]"),
        BarColumn(bar_width=30, complete_style="#3584E4", finished_style="#62A0EA"),
        console=console
    ) as progress:
        task = progress.add_task("Configuring developer stack", total=len(steps))

        for desc, action in steps:
            progress.update(task, description=desc)
            try:
                action()
            except Exception as e:
                console.print(f"[yellow]Step '{desc}' notice:[/yellow] {e}")
            progress.advance(task)

    console.print("\n[bold green]✓ Developer toolchain setup and update sequence finished.[/bold green]\n")

    # Print Verification Summary Table
    ver_table = Table(title="[bold #62A0EA]Developer Stack Verification Summary[/bold #62A0EA]", border_style="#1C71D8", header_style="bold #62A0EA")
    ver_table.add_column("Component", style="bold white", width=22)
    ver_table.add_column("Check Command / Path", style="white", width=32)
    ver_table.add_column("Status / Version", style="white")

    ver_table.add_row("Apache2 Web Server", "systemctl is-active apache2", check_service_status("apache2"))
    ver_table.add_row("MariaDB Database", "systemctl is-active mariadb", check_service_status("mariadb"))
    ver_table.add_row("PHP Runtime", "php -v", get_php_status())
    ver_table.add_row("Node.js & npm", "node -v / npm -v", get_node_npm_status())
    ver_table.add_row("Laravel CLI", "laravel --version", get_laravel_status())
    ver_table.add_row("Flutter SDK", "flutter --version", get_flutter_status())
    ver_table.add_row("Flame Engine", "Flutter 2D Game Engine", get_flame_status())
    ver_table.add_row("Zen Browser", "/usr/local/bin/zen-browser", get_zen_status())
    ver_table.add_row("Papirus Icon Theme", "Papirus-Dark", get_icon_theme())

    console.print(ver_table)

def main():
    parser = argparse.ArgumentParser(
        prog="eclipse-control",
        description="Eclipse OS System Controller & Toolchain Manager",
        formatter_class=argparse.RawDescriptionHelpFormatter
    )
    subparsers = parser.add_subparsers(dest="command", help="Command to execute")

    # status
    status_parser = subparsers.add_parser("status", help="Display system health and developer stack status")

    # theme
    theme_parser = subparsers.add_parser("theme", help="Update GTK desktop theme accent")
    theme_parser.add_argument("name", choices=["fedora", "adwaita", "cyan", "emerald"], help="Theme accent option")

    # install-devtools
    devtools_parser = subparsers.add_parser("install-devtools", help="Automated developer toolchain installer and updater")

    args = parser.parse_args()

    if args.command == "status":
        cmd_status(args)
    elif args.command == "theme":
        cmd_theme(args)
    elif args.command == "install-devtools":
        cmd_install_devtools(args)
    else:
        parser.print_help()

if __name__ == "__main__":
    main()
