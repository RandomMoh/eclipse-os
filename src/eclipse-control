def get_icon_theme():
    xsettings_path = os.path.expanduser("~/.config/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml")
    if os.path.exists(xsettings_path):
        try:
            with open(xsettings_path, "r") as f:
                content = f.read()
                if "IconThemeName" in content:
                    for line in content.splitlines():
                        if "IconThemeName" in line and 'value="' in line:
                            val = line.split('value="')[1].split('"')[0]
                            return f"[bold green]● Active[/bold green] ({val})"
        except Exception:
            pass
    if os.path.exists("/usr/share/icons/Papirus-Dark") or os.path.exists("/usr/share/icons/Papirus"):
        return "[bold green]● Installed[/bold green] (Papirus-Dark)"
    return "[bold green]● Installed[/bold green] (Papirus-Dark)"

def get_active_theme():
    user_gtk_css = os.path.expanduser("~/.config/gtk-3.0/gtk.css")
    sys_gtk_css = "/etc/gtk-3.0/gtk.css"
    xsettings_path = os.path.expanduser("~/.config/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml")

    if os.path.exists(xsettings_path):
        try:
            with open(xsettings_path, "r") as f:
                content = f.read()
                if "Eclipse-Fedora" in content:
                    return "Eclipse-Fedora (#3584E4)"
                elif "Eclipse-AdwaitaDark" in content:
                    return "Eclipse-AdwaitaDark (#24292E)"
                elif "Eclipse-CyberCyan" in content or "Eclipse-Cyan" in content:
                    return "Eclipse-CyberCyan (#06B6D4)"
                elif "Eclipse-Emerald" in content:
                    return "Eclipse-Emerald (#10B981)"
                elif "Eclipse-Crimson" in content:
                    return "Eclipse-Crimson (#E11D48)"
                elif "Eclipse-Dark" in content:
                    return "Eclipse-Dark (#4C1D95)"
        except Exception:
            pass

    for path in (user_gtk_css, sys_gtk_css):
        if os.path.exists(path):
            try:
                with open(path, "r") as f:
                    content = f.read()
                    if "#3584E4" in content or "fedora" in content.lower():
                        return "Eclipse-Fedora (#3584E4)"
                    elif "#24292E" in content or "adwaita" in content.lower():
                        return "Eclipse-AdwaitaDark (#24292E)"
                    elif "#06B6D4" in content or "cyan" in content.lower():
                        return "Eclipse-CyberCyan (#06B6D4)"
                    elif "#10B981" in content or "emerald" in content.lower():
                        return "Eclipse-Emerald (#10B981)"
            except Exception:
                pass
    return "Eclipse-Fedora (Default Fedora Blue)"

