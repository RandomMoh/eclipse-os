def check_service_status(service_name):
    try:
        res = subprocess.run(["systemctl", "is-active", service_name], capture_output=True, text=True, check=False, timeout=3)
        status = res.stdout.strip()
        if status == "active":
            return "[bold green]● active (running)[/bold green]"
        elif status in ("inactive", "failed"):
            return f"[dim red]○ {status}[/dim red]"
        else:
            return f"[yellow]○ {status or 'unknown'}[/yellow]"
    except Exception:
        return "[dim white]○ unmonitored[/dim white]"

def get_php_status():
    try:
        res = subprocess.run(["php", "-v"], capture_output=True, text=True, check=False, timeout=3)
        if res.returncode == 0 and res.stdout:
            first_line = res.stdout.splitlines()[0]
            parts = first_line.split()
            ver = f"{parts[0]} {parts[1]}" if len(parts) >= 2 else first_line
            return f"[bold green]● Installed[/bold green] ({ver})"
    except Exception:
        pass
    return "[dim red]○ Not Installed[/dim red]"

def get_node_npm_status():
    try:
        res_node = subprocess.run(["node", "-v"], capture_output=True, text=True, check=False, timeout=3)
        res_npm = subprocess.run(["npm", "-v"], capture_output=True, text=True, check=False, timeout=3)
        if res_node.returncode == 0:
            node_ver = res_node.stdout.strip()
            npm_ver = res_npm.stdout.strip() if res_npm.returncode == 0 else "N/A"
            return f"[bold green]● Installed[/bold green] (Node {node_ver} / npm {npm_ver})"
    except Exception:
        pass
    return "[dim red]○ Not Installed[/dim red]"

def get_laravel_status():
    try:
        laravel_bin = shutil.which("laravel") or "/usr/local/bin/laravel"
        if os.path.exists(laravel_bin) or shutil.which("laravel"):
            res = subprocess.run(["laravel", "--version"], capture_output=True, text=True, check=False, timeout=3)
            if res.returncode == 0 and res.stdout:
                ver = res.stdout.strip()
                return f"[bold green]● Installed[/bold green] ({ver})"
            return "[bold green]● Installed[/bold green] (Laravel CLI)"
    except Exception:
        pass
    return "[dim red]○ Not Installed[/dim red]"

def get_flutter_status():
    try:
        flutter_bin = shutil.which("flutter") or "/opt/flutter/bin/flutter"
        if os.path.exists(flutter_bin) or shutil.which("flutter"):
            res = subprocess.run([flutter_bin, "--version"], capture_output=True, text=True, check=False, timeout=5)
            if res.returncode == 0 and res.stdout:
                first_line = res.stdout.splitlines()[0]
                return f"[bold green]● Installed[/bold green] ({first_line})"
            return "[bold green]● Installed[/bold green] (/opt/flutter)"
    except Exception:
