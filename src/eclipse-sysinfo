#!/usr/bin/env python3

import os
import sys
import platform
import socket
import shutil
import subprocess
from PyQt5.QtWidgets import (QApplication, QMainWindow, QWidget, QVBoxLayout,
                             QHBoxLayout, QLabel, QProgressBar, QFrame, QGridLayout)
from PyQt5.QtCore import Qt, QTimer
from PyQt5.QtGui import QFont, QColor, QPalette

class MetricWidget(QFrame):
    def __init__(self, title, value="", has_progress=False, parent=None):
        super().__init__(parent)
        
        # Doppel-Bezel equivalent in QSS
        self.setStyleSheet("""
            QFrame {
                background-color: #0C0D11;
                border-radius: 20px;
                border: 1px solid rgba(255, 255, 255, 0.05);
            }
        """)
        
        outer_layout = QVBoxLayout(self)
        outer_layout.setContentsMargins(6, 6, 6, 6)
        
        self.inner_core = QFrame()
        self.inner_core.setStyleSheet("""
            QFrame {
                background-color: #050505;
                border-radius: 14px;
                border: none;
            }
        """)
        
        layout = QVBoxLayout(self.inner_core)
        layout.setContentsMargins(24, 24, 24, 24)
        
        self.title_label = QLabel(title)
        self.title_label.setStyleSheet("color: rgba(255,255,255,0.4); font-weight: 600; font-size: 10px; letter-spacing: 2px; border: none; background: transparent;")
        
        self.value_label = QLabel(value)
        self.value_label.setStyleSheet("color: #EAEAEA; font-size: 16px; font-weight: 500; border: none; background: transparent; margin-top: 8px;")
        self.value_label.setWordWrap(True)
        
        layout.addWidget(self.title_label)
        layout.addWidget(self.value_label)
        
        if has_progress:
            self.progress = QProgressBar()
            self.progress.setTextVisible(False)
            self.progress.setFixedHeight(4)
            self.progress.setStyleSheet("""
                QProgressBar {
                    background-color: rgba(255, 255, 255, 0.05);
                    border: none;
                    border-radius: 2px;
                    margin-top: 12px;
                }
                QProgressBar::chunk {
                    background-color: #EAEAEA;
                    border-radius: 2px;
                }
            """)
            layout.addWidget(self.progress)
            self.progress.hide()
        else:
            self.progress = None
            
        outer_layout.addWidget(self.inner_core)
            
    def update_value(self, value, pct=None):
        self.value_label.setText(value)
        if self.progress is not None and pct is not None:
            self.progress.show()
            self.progress.setValue(int(pct))

class SysInfoApp(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Eclipse OS System Info")
        self.resize(750, 550)
        self.setStyleSheet("QMainWindow { background-color: #050505; }")
        
        central_widget = QWidget()
        self.setCentralWidget(central_widget)
        main_layout = QVBoxLayout(central_widget)
        main_layout.setContentsMargins(40, 40, 40, 40)
        main_layout.setSpacing(32)
        
        # Header
        header_layout = QVBoxLayout()
        header_label_small = QLabel("ECLIPSE OS")
        header_label_small.setStyleSheet("color: rgba(255,255,255,0.3); font-size: 10px; font-weight: bold; letter-spacing: 3px;")
        header_label_main = QLabel("Hardware Status")
        header_label_main.setStyleSheet("color: #EAEAEA; font-size: 28px; font-weight: bold;")
        
        header_layout.addWidget(header_label_small)
        header_layout.addWidget(header_label_main)
        header_layout.setSpacing(4)
        main_layout.addLayout(header_layout)
        
        # Bento Grid
        grid = QGridLayout()
        grid.setSpacing(20)
        
        self.os_metric = MetricWidget("OPERATING SYSTEM", "Eclipse OS v1.0 Syzygy")
        self.cpu_metric = MetricWidget("PROCESSOR")
        self.mem_metric = MetricWidget("SYSTEM MEMORY", has_progress=True)
        self.disk_metric = MetricWidget("PRIMARY DISK ( / )", has_progress=True)
        self.uptime_metric = MetricWidget("SYSTEM UPTIME")
        self.net_metric = MetricWidget("NETWORK ADDRESSES")
        
        # Asymmetrical Layout (Bento)
        grid.addWidget(self.os_metric, 0, 0, 1, 2)
        grid.addWidget(self.cpu_metric, 1, 0, 1, 2)
        grid.addWidget(self.mem_metric, 2, 0)
        grid.addWidget(self.disk_metric, 2, 1)
        grid.addWidget(self.uptime_metric, 3, 0)
        grid.addWidget(self.net_metric, 3, 1)
        
        main_layout.addLayout(grid)
        
        self.timer = QTimer(self)
        self.timer.timeout.connect(self.refresh_metrics)
        self.timer.start(2000)
        self.refresh_metrics()

    def get_uptime(self):
        try:
            with open('/proc/uptime', 'r') as f:
                total_seconds = float(f.readline().split()[0])
            days = int(total_seconds // 86400)
            hours = int((total_seconds % 86400) // 3600)
            minutes = int((total_seconds % 3600) // 60)
            parts = []
            if days > 0:
                parts.append(f"{days}d")
            if hours > 0 or days > 0:
                parts.append(f"{hours}h")
            parts.append(f"{minutes}m")
            return " ".join(parts)
        except Exception:
            return "Unknown"

    def get_cpu_model(self):
        try:
            with open('/proc/cpuinfo', 'r') as f:
                for line in f:
                    if 'model name' in line:
                        return line.split(':', 1)[1].strip()
        except Exception:
            pass
        return platform.processor() or "Generic x86_64"

    def refresh_metrics(self):
        self.cpu_metric.update_value(self.get_cpu_model())
        self.uptime_metric.update_value(self.get_uptime())
        
        try:
            mem = {}
            with open('/proc/meminfo', 'r') as f:
                for line in f:
                    parts = line.split(':')
                    if len(parts) == 2:
                        mem[parts[0].strip()] = int(parts[1].strip().split()[0])
            total_mb = mem.get('MemTotal', 0) // 1024
            available_mb = mem.get('MemAvailable', mem.get('MemFree', 0)) // 1024
            used_mb = max(0, total_mb - available_mb)
            pct = (used_mb / total_mb * 100) if total_mb > 0 else 0.0
            self.mem_metric.update_value(f"{used_mb} MB / {total_mb} MB", pct)
        except Exception:
            pass
            
        try:
            usage = shutil.disk_usage('/')
            total_gb = usage.total / (1024 ** 3)
            used_gb = usage.used / (1024 ** 3)
            pct = (usage.used / usage.total * 100) if usage.total > 0 else 0.0
            self.disk_metric.update_value(f"{used_gb:.1f} GB / {total_gb:.1f} GB", pct)
        except Exception:
            pass

        ips = {}
        try:
            res = subprocess.run(['ip', '-4', 'addr', 'show'], capture_output=True, text=True, check=False)
            if res.returncode == 0:
                current_iface = None
                for line in res.stdout.splitlines():
                    line = line.strip()
                    if not line: continue
                    parts = line.split()
                    if len(parts) >= 2 and line[0].isdigit() and ':' in parts[1]:
                        current_iface = parts[1].rstrip(':')
                    elif 'inet' in parts and current_iface:
                        idx = parts.index('inet')
                        if idx + 1 < len(parts):
                            ips[current_iface] = parts[idx + 1].split('/')[0]
        except Exception:
            pass
        
        if not ips:
            ips['lo'] = '127.0.0.1'
            
        net_str = " | ".join([f"{iface}: {ip}" for iface, ip in ips.items()])
        self.net_metric.update_value(net_str)

def main():
    app = QApplication(sys.argv)
    
    font = app.font()
    font.setFamily("sans-serif")
    app.setFont(font)
    
    window = SysInfoApp()
    window.show()
    sys.exit(app.exec_())

if __name__ == "__main__":
    main()
